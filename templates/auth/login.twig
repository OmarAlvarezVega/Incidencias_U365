{% extends 'layouts/auth.twig' %}
{% block title %}Iniciar sesión{% endblock %}
{% block content %}
<h1 class="h4 fw-bold mb-1">Gestión de incidencias</h1>
<p class="text-muted small mb-4">Accede con tu usuario o correo corporativo.</p>
<form method="post" action="/login" novalidate>
    {{ csrf_field() }}
    <div class="mb-3">
        <label class="form-label" for="identifier">Usuario o correo</label>
        <input class="form-control" id="identifier" name="identifier" value="{{ old('identifier') }}" autocomplete="username" required autofocus>
    </div>
    <div class="mb-3">
        <label class="form-label" for="password">Contraseña</label>
        <input class="form-control" id="password" name="password" type="password" autocomplete="current-password" required>
    </div>
    <button class="btn btn-primary w-100" type="submit">Entrar</button>
</form>
<div class="text-center mt-3"><a class="small" href="/recuperar">¿Has olvidado tu contraseña?</a></div>
{% endblock %}
