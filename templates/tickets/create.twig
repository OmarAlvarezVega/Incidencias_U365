{% extends 'layouts/app.twig' %}
{% block title %}Nueva incidencia{% endblock %}
{% block content %}
<div class="page-header"><div><h1>Nueva incidencia</h1><div class="subtitle">Alta manual (teléfono, visita, petición interna)</div></div></div>
<form method="post" action="/incidencias" enctype="multipart/form-data">
{{ csrf_field() }}
<div class="row g-3">
<div class="col-lg-8">
    <div class="card"><div class="card-body">
        <div class="mb-3">
            <label class="form-label required" for="subject">Asunto</label>
            <input class="form-control {{ error('subject') ? 'is-invalid' }}" id="subject" name="subject" maxlength="255" value="{{ old('subject') }}" required autofocus>
            {% if error('subject') %}<div class="invalid-feedback">{{ error('subject') }}</div>{% endif %}
        </div>
        <div class="mb-3">
            <label class="form-label" for="description">Descripción</label>
            <textarea class="form-control" id="description" name="description" rows="8">{{ old('description') }}</textarea>
            <div class="form-text">Lo que ha contado el cliente. Es visible en la ficha para todo el equipo.</div>
        </div>
        <div class="mb-3">
            <label class="form-label" for="internal_summary">Observaciones internas</label>
            <textarea class="form-control" id="internal_summary" name="internal_summary" rows="2">{{ old('internal_summary') }}</textarea>
            <div class="form-text">Nunca se envían al cliente.</div>
        </div>
        {% if can('attachments.upload') %}
        <div class="row g-2">
            <div class="col-md-8"><label class="form-label" for="files">Adjuntos</label><input class="form-control" type="file" id="files" name="files[]" multiple></div>
            <div class="col-md-4"><label class="form-label" for="files_visibility">Visibilidad</label>
                <select class="form-select" id="files_visibility" name="files_visibility"><option value="internal">Internos</option><option value="public">Visibles para el cliente</option></select></div>
        </div>
        {% endif %}
    </div></div>
</div>
<div class="col-lg-4">
    <div class="card mb-3"><div class="card-header">Cliente</div><div class="card-body">
        <div class="mb-2"><label class="form-label small" for="client_filter">Buscar cliente</label>
            <input class="form-control form-control-sm" id="client_filter" data-client-filter placeholder="Nombre, NIF o código" autocomplete="off"></div>
        <div class="mb-2"><label class="form-label" for="client_id">Cliente</label>
            <select class="form-select {{ error('client_id') ? 'is-invalid' }}" id="client_id" name="client_id" data-client-select="#contact_id">
                <option value="">Selecciona un cliente…</option>
                {% if client %}<option value="{{ client.id }}" selected>{{ client.trade_name ?: client.legal_name }}</option>{% endif %}
                {% for c in catalog.clients %}{% if not client or c.id != client.id %}<option value="{{ c.id }}" {{ old('client_id') == c.id ~ '' ? 'selected' }}>{{ c.name }}</option>{% endif %}{% endfor %}
            </select>
            {% if error('client_id') %}<div class="invalid-feedback">{{ error('client_id') }}</div>{% endif %}</div>
        <div class="mb-2"><label class="form-label" for="contact_id">Contacto</label>
            <select class="form-select" id="contact_id" name="contact_id" data-selected="{{ old('contact_id') }}"><option value="">Sin contacto</option></select></div>
        <div class="form-check"><input class="form-check-input" type="checkbox" id="sin_cliente" name="sin_cliente" value="1"><label class="form-check-label small" for="sin_cliente">Cliente sin identificar (se asociará después)</label></div>
        <div class="form-check"><input class="form-check-input" type="checkbox" id="send_ack" name="send_ack" value="1"><label class="form-check-label small" for="send_ack">Enviar acuse de recibo por correo al contacto</label></div>
    </div></div>
    <div class="card"><div class="card-header">Clasificación y asignación</div><div class="card-body">
        <div class="mb-2"><label class="form-label required" for="priority_id">Prioridad</label>
            <select class="form-select" id="priority_id" name="priority_id">{% for p in catalog.priorities %}<option value="{{ p.id }}" {{ (old('priority_id') ? old('priority_id') == p.id ~ '' : p.code == catalog.default_priority) ? 'selected' }}>{{ p.name }}</option>{% endfor %}</select></div>
        <div class="mb-2"><label class="form-label" for="category_id">Categoría</label>
            <select class="form-select" id="category_id" name="category_id"><option value="">Sin categoría</option>{% for c in catalog.categories %}<option value="{{ c.id }}" {{ old('category_id') == c.id ~ '' ? 'selected' }}>{{ c.parent ? c.parent ~ ' › ' }}{{ c.name }}</option>{% endfor %}</select></div>
        <div class="mb-2"><label class="form-label" for="team_id">Equipo</label>
            <select class="form-select" id="team_id" name="team_id"><option value="">Sin equipo</option>{% for t in catalog.teams %}<option value="{{ t.id }}" {{ old('team_id') == t.id ~ '' ? 'selected' }}>{{ t.name }}</option>{% endfor %}</select></div>
        <div class="mb-2"><label class="form-label" for="owner_user_id">Responsable</label>
            <select class="form-select" id="owner_user_id" name="owner_user_id"><option value="">Sin asignar</option>
            {% for u in catalog.staff %}{% if can('tickets.assign') or u.id == current_user.id %}<option value="{{ u.id }}" {{ old('owner_user_id') == u.id ~ '' ? 'selected' }}>{{ u.name }}</option>{% endif %}{% endfor %}</select></div>
        {% if can('tickets.assign') %}
        <div class="mb-2"><label class="form-label" for="collaborators">Colaboradores</label>
            <select class="form-select" id="collaborators" name="collaborators[]" multiple size="4">{% for u in catalog.staff %}<option value="{{ u.id }}">{{ u.name }}</option>{% endfor %}</select>
            <div class="form-text">Ctrl/Cmd + clic para elegir varios. Con colaboradores la incidencia es compartida.</div></div>
        {% endif %}
        <div class="mb-2"><label class="form-label" for="due_at">Fecha límite</label><input class="form-control" type="datetime-local" id="due_at" name="due_at" value="{{ old('due_at') }}"></div>
        {% if catalog.tags %}
        <div class="mb-2"><label class="form-label" for="tags">Etiquetas</label>
            <select class="form-select" id="tags" name="tags[]" multiple size="3">{% for t in catalog.tags %}<option value="{{ t.id }}">{{ t.name }}</option>{% endfor %}</select></div>
        {% endif %}
    </div></div>
</div>
</div>
<div class="mt-3 d-flex gap-2"><button class="btn btn-primary" type="submit">Crear incidencia</button><a class="btn btn-light" href="/incidencias">Cancelar</a></div>
</form>
{% endblock %}
