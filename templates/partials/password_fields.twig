<div class="mb-3">
    <label class="form-label required" for="password">Nueva contraseña</label>
    <input class="form-control {{ error('password') ? 'is-invalid' }}" id="password" name="password" type="password" autocomplete="new-password" minlength="{{ setting('security.password_min_length', 12) }}" required>
    {% if error('password') %}<div class="invalid-feedback">{{ error('password') }}</div>{% endif %}
    <div class="form-text">Mínimo {{ setting('security.password_min_length', 12) }} caracteres, combinando al menos tres de: minúsculas, mayúsculas, números y símbolos. Sin tu nombre ni tu correo.</div>
</div>
<div class="mb-3">
    <label class="form-label required" for="password_confirmation">Repite la contraseña</label>
    <input class="form-control" id="password_confirmation" name="password_confirmation" type="password" autocomplete="new-password" required>
</div>
