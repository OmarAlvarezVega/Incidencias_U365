{% extends 'layouts/app.twig' %}
{% block title %}Mi perfil{% endblock %}
{% block content %}
<div class="page-header"><div><h1>Mi perfil</h1><div class="subtitle">{{ current_user.roleName }}</div></div>
<a class="btn btn-outline-primary btn-sm" href="/perfil/contrasena"><i class="bi bi-key"></i> Cambiar contraseña</a></div>
<div class="row g-3">
<div class="col-lg-5">
    <div class="card mb-3"><div class="card-header">Datos</div><div class="card-body">
        <dl class="row mb-0 small">
            <dt class="col-5">Nombre</dt><dd class="col-7">{{ profile.first_name }} {{ profile.last_name }}</dd>
            <dt class="col-5">Correo</dt><dd class="col-7">{{ profile.email }}</dd>
            <dt class="col-5">Usuario</dt><dd class="col-7">{{ profile.username ?: '—' }}</dd>
            <dt class="col-5">Teléfono</dt><dd class="col-7">{{ profile.corporate_phone ?: '—' }}</dd>
            <dt class="col-5">Equipos</dt><dd class="col-7">{% for t in teams %}{{ t.name }}{% if t.is_lead %} (responsable){% endif %}{% if not loop.last %}, {% endif %}{% else %}—{% endfor %}</dd>
            <dt class="col-5">Último acceso</dt><dd class="col-7">{{ profile.last_login_at|fecha }}</dd>
            <dt class="col-5">Contraseña cambiada</dt><dd class="col-7">{{ profile.password_changed_at|fecha }}</dd>
        </dl>
        <p class="small text-muted mt-3 mb-0">Para corregir tus datos, pide a un administrador que edite tu ficha de empleado.</p>
    </div></div>
    <div class="card"><div class="card-header d-flex justify-content-between align-items-center">Sesiones abiertas
        <form method="post" action="/perfil/sesiones/cerrar" data-confirm="Se cerrarán todas tus sesiones salvo esta.">{{ csrf_field() }}<button class="btn btn-sm btn-outline-danger">Cerrar las demás</button></form></div>
        <ul class="list-group list-group-flush small">
        {% for s in sessions %}
            <li class="list-group-item"><strong>{{ s.ip ?: 'IP desconocida' }}</strong>{% if s.current %} <span class="badge text-bg-success">esta sesión</span>{% endif %}<br>
            <span class="text-muted">{{ s.user_agent|slice(0, 90) }}</span><br><span class="text-muted">Última actividad {{ s.last_seen_at|hace }}</span></li>
        {% else %}<li class="list-group-item text-muted">Sin sesiones registradas.</li>{% endfor %}
        </ul>
    </div>
</div>
<div class="col-lg-7">
    <div class="card"><div class="card-header">Avisos</div><div class="card-body">
    <form method="post" action="/perfil/notificaciones">
        {{ csrf_field() }}
        <table class="table table-sm">
            <thead><tr><th>Evento</th><th class="text-center">En la aplicación</th><th class="text-center">Por correo</th></tr></thead>
            <tbody>
            {% for e in events %}
                <tr><td>{{ e.label }}</td>
                <td class="text-center"><input class="form-check-input" type="checkbox" name="pref[{{ e.code }}][in_app]" value="1" {{ e.in_app ? 'checked' }} aria-label="{{ e.label }} en la aplicación"></td>
                <td class="text-center"><input class="form-check-input" type="checkbox" name="pref[{{ e.code }}][email]" value="1" {{ e.email ? 'checked' }} aria-label="{{ e.label }} por correo"></td></tr>
            {% endfor %}
            </tbody>
        </table>
        <button class="btn btn-primary btn-sm">Guardar preferencias</button>
    </form>
    </div></div>
</div>
</div>
{% endblock %}
