{% extends 'layouts/app.twig' %}
{% block title %}Cambiar contraseña{% endblock %}
{% block content %}
<div class="page-header"><div><h1>Cambiar contraseña</h1>
{% if forced %}<div class="subtitle text-danger">Tu contraseña es temporal: debes cambiarla para continuar.</div>{% endif %}</div></div>
<div class="row"><div class="col-lg-6">
<div class="card"><div class="card-body">
<form method="post" action="/perfil/contrasena">
    {{ csrf_field() }}
    <div class="mb-3">
        <label class="form-label required" for="current_password">Contraseña actual</label>
        <input class="form-control {{ error('current_password') ? 'is-invalid' }}" id="current_password" name="current_password" type="password" autocomplete="current-password" required>
        {% if error('current_password') %}<div class="invalid-feedback">{{ error('current_password') }}</div>{% endif %}
    </div>
    {% include 'partials/password_fields.twig' %}
    <button class="btn btn-primary" type="submit">Cambiar contraseña</button>
</form>
</div></div></div></div>
{% endblock %}
