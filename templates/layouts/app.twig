<!doctype html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <meta name="csrf-token" content="{{ csrf_token() }}">
    <title>{% block title %}Incidencias{% endblock %} · UNIVERS365</title>
    <link rel="icon" href="{{ asset('img/favicon.svg') }}" type="image/svg+xml">
    <link rel="stylesheet" href="{{ asset('vendor/bootstrap/bootstrap.min.css') }}">
    <link rel="stylesheet" href="{{ asset('vendor/bootstrap-icons/bootstrap-icons.min.css') }}">
    <link rel="stylesheet" href="{{ asset('css/app.css') }}">
</head>
<body>
<div class="app-shell">
    <aside class="app-sidebar" id="sidebar" aria-label="Navegación principal">
        <a class="brand" href="/">
            <span class="logo">U3</span>
            <span>UNIVERS365<small>Gestión de incidencias</small></span>
        </a>
        <nav class="nav flex-column pb-4">
            <div class="nav-section">Trabajo</div>
            <a class="nav-link {{ active('/', true) }}" href="/"><i class="bi bi-speedometer2"></i> Panel</a>
            <a class="nav-link {{ active('/incidencias') }}" href="/incidencias"><i class="bi bi-inbox"></i> Incidencias</a>
            <a class="nav-link" href="/incidencias?vista=mias"><i class="bi bi-person-check"></i> Mis incidencias</a>
            {% if can('tickets.view.unassigned') or can('tickets.view.all') %}
            <a class="nav-link" href="/incidencias?vista=sin_asignar"><i class="bi bi-person-dash"></i> Sin asignar</a>
            {% endif %}
            {% if can('time.log') %}
            <a class="nav-link {{ active('/mis-tiempos') }}" href="/mis-tiempos"><i class="bi bi-clock-history"></i> Mis tiempos</a>
            {% endif %}
            {% if can('tickets.review_queue') %}
            <a class="nav-link {{ active('/revision') }}" href="/revision"><i class="bi bi-funnel"></i> Revisión de entrada</a>
            {% endif %}
            {% if can_any('clients.view', 'employees.view', 'workload.view.all', 'workload.view.team', 'reports.view.all', 'reports.view.team') %}
            <div class="nav-section">Gestión</div>
            {% endif %}
            {% if can('clients.view') %}
            <a class="nav-link {{ active('/clientes') }}" href="/clientes"><i class="bi bi-buildings"></i> Clientes</a>
            {% endif %}
            {% if can('employees.view') %}
            <a class="nav-link {{ active('/empleados') }}" href="/empleados"><i class="bi bi-people"></i> Empleados</a>
            {% endif %}
            {% if can_any('workload.view.all', 'workload.view.team') %}
            <a class="nav-link {{ active('/carga') }}" href="/carga"><i class="bi bi-bar-chart-steps"></i> Carga de trabajo</a>
            {% endif %}
            {% if can_any('reports.view.all', 'reports.view.team') %}
            <a class="nav-link {{ active('/informes') }}" href="/informes"><i class="bi bi-graph-up"></i> Informes</a>
            {% endif %}
            {% if can_any('permissions.manage', 'users.manage', 'catalogs.manage', 'sla.manage', 'integrations.manage', 'templates.manage', 'settings.manage', 'audit.view', 'gdpr.manage', 'backups.manage') %}
            <div class="nav-section">Administración</div>
            {% endif %}
            {% if can('permissions.manage') %}
            <a class="nav-link {{ active('/admin/roles') }}" href="/admin/roles"><i class="bi bi-shield-lock"></i> Roles y permisos</a>
            {% endif %}
            {% if can('users.manage') %}
            <a class="nav-link {{ active('/admin/equipos') }}" href="/admin/equipos"><i class="bi bi-diagram-3"></i> Equipos</a>
            {% endif %}
            {% if can('catalogs.manage') %}
            <a class="nav-link {{ active('/admin/catalogos') }}" href="/admin/catalogos"><i class="bi bi-tags"></i> Catálogos</a>
            {% endif %}
            {% if can('sla.manage') %}
            <a class="nav-link {{ active('/admin/sla') }}" href="/admin/sla"><i class="bi bi-stopwatch"></i> SLA</a>
            {% endif %}
            {% if can('integrations.manage') %}
            <a class="nav-link {{ active('/admin/correo') }}" href="/admin/correo"><i class="bi bi-envelope-at"></i> Correo</a>
            <a class="nav-link {{ active('/admin/whatsapp') }}" href="/admin/whatsapp"><i class="bi bi-whatsapp"></i> WhatsApp</a>
            {% endif %}
            {% if can('templates.manage') %}
            <a class="nav-link {{ active('/admin/plantillas') }}" href="/admin/plantillas"><i class="bi bi-file-earmark-text"></i> Plantillas</a>
            {% endif %}
            {% if can('settings.manage') %}
            <a class="nav-link {{ active('/admin/ajustes') }}" href="/admin/ajustes"><i class="bi bi-gear"></i> Ajustes</a>
            <a class="nav-link {{ active('/admin/procesos') }}" href="/admin/procesos"><i class="bi bi-cpu"></i> Procesos</a>
            {% endif %}
            {% if can('audit.view') %}
            <a class="nav-link {{ active('/admin/auditoria') }}" href="/admin/auditoria"><i class="bi bi-journal-check"></i> Auditoría</a>
            {% endif %}
            {% if can('gdpr.manage') %}
            <a class="nav-link {{ active('/admin/rgpd') }}" href="/admin/rgpd"><i class="bi bi-person-lock"></i> RGPD</a>
            {% endif %}
            {% if can('backups.manage') %}
            <a class="nav-link {{ active('/admin/copias') }}" href="/admin/copias"><i class="bi bi-hdd-stack"></i> Copias de seguridad</a>
            {% endif %}
        </nav>
    </aside>

    <div class="app-main">
        <header class="app-topbar">
            <button class="btn btn-light sidebar-toggle" type="button" data-toggle-sidebar aria-label="Abrir menú"><i class="bi bi-list"></i></button>
            <div class="search" data-global-search>
                <i class="bi bi-search"></i>
                <input type="search" class="form-control" placeholder="Buscar incidencias, clientes, contactos, correos…  (/)" aria-label="Búsqueda global" autocomplete="off">
                <div class="search-results" role="listbox"></div>
            </div>
            <span class="timer-pill d-none" data-active-timer title="Temporizador en marcha">
                <i class="bi bi-stopwatch"></i> <a class="text-reset text-decoration-none" href="#" data-timer-link></a> <span data-timer-clock>00:00:00</span>
            </span>
            {% if can('tickets.create') %}
            <a class="btn btn-primary btn-sm d-none d-md-inline-flex align-items-center gap-1" href="/incidencias/nueva"><i class="bi bi-plus-lg"></i> Nueva incidencia</a>
            {% endif %}
            <div class="dropdown">
                <button class="btn btn-light position-relative" type="button" data-bs-toggle="dropdown" data-notifications-toggle aria-label="Notificaciones">
                    <i class="bi bi-bell"></i>
                    {% set unread = unread_notifications() %}
                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger {{ unread ? '' : 'd-none' }}" data-notifications-count>{{ unread }}</span>
                </button>
                <div class="dropdown-menu dropdown-menu-end p-0" style="width: 360px; max-width: 92vw;">
                    <div class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom">
                        <strong>Notificaciones</strong>
                        <a href="/notificaciones" class="small">Ver todas</a>
                    </div>
                    <div data-notifications-list class="small" style="max-height: 400px; overflow-y: auto;">
                        <div class="p-3 text-muted">Cargando…</div>
                    </div>
                </div>
            </div>
            <div class="dropdown">
                <button class="btn btn-link text-decoration-none text-reset d-flex align-items-center gap-2 p-0" type="button" data-bs-toggle="dropdown" aria-label="Perfil">
                    <span class="avatar">{{ current_user.initials }}</span>
                    <span class="user-name text-start lh-sm">
                        <span class="d-block fw-semibold small">{{ current_user.name }}</span>
                        <span class="d-block text-muted" style="font-size:.72rem">{{ current_user.roleName }}</span>
                    </span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><a class="dropdown-item" href="/perfil"><i class="bi bi-person me-2"></i>Mi perfil</a></li>
                    <li><a class="dropdown-item" href="/perfil/contrasena"><i class="bi bi-key me-2"></i>Cambiar contraseña</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <form method="post" action="/logout">
                            {{ csrf_field() }}
                            <button class="dropdown-item" type="submit"><i class="bi bi-box-arrow-right me-2"></i>Cerrar sesión</button>
                        </form>
                    </li>
                </ul>
            </div>
        </header>

        <main class="app-content">
            {% for f in flashes %}
                <div class="alert alert-{{ f.type == 'danger' ? 'danger' : (f.type == 'warning' ? 'warning' : (f.type == 'info' ? 'info' : 'success')) }} alert-dismissible fade show" role="alert">
                    {{ f.message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                </div>
            {% endfor %}
            {% block content %}{% endblock %}
        </main>
    </div>
</div>

<div class="modal fade" id="confirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Confirmar acción</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button></div>
            <div class="modal-body" data-confirm-text>¿Seguro?</div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger" data-confirm-ok>Confirmar</button>
            </div>
        </div>
    </div>
</div>
<div class="loading-overlay" data-loading><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Cargando…</span></div></div>

<script src="{{ asset('vendor/bootstrap/bootstrap.bundle.min.js') }}"></script>
{% block scripts_before %}{% endblock %}
<script src="{{ asset('js/app.js') }}" type="module"></script>
{% block scripts %}{% endblock %}
</body>
</html>
