{% extends 'layouts/app.twig' %}
{% import 'partials/macros.twig' as m %}
{% block title %}Registro · {{ a.name }}{% endblock %}
{% block content %}
<div class="page-header">
    <div><h1>Registro de {{ a.name }}</h1><div class="subtitle">{{ a.address }}</div></div>
    <div class="d-flex gap-2"><a class="btn btn-outline-secondary btn-sm" href="/admin/correo/{{ a.id }}">Configuración</a>
    <form method="post" action="/admin/correo/{{ a.id }}/procesar" data-loading>{{ csrf_field() }}<button class="btn btn-outline-primary btn-sm" {{ a.active ? '' : 'disabled' }}><i class="bi bi-arrow-repeat"></i> Procesar ahora</button></form></div>
</div>
{% set st = {pending: 'Pendiente', processed: 'Procesado', review: 'En revisión', ignored: 'Ignorado', failed: 'Error'} %}
<div class="card mb-3"><div class="card-header">Últimos 30 mensajes</div><div class="table-responsive"><table class="table table-sm align-middle mb-0 small">
    <thead><tr><th></th><th>Fecha</th><th>De / para</th><th>Asunto</th><th>Estado</th><th>Incidencia</th></tr></thead>
    <tbody>
    {% for msg in messages %}
    <tr>
        <td><i class="bi bi-{{ msg.direction == 'inbound' ? 'box-arrow-in-down text-primary' : 'box-arrow-up text-success' }}" title="{{ msg.direction == 'inbound' ? 'Recibido' : 'Enviado' }}"></i></td>
        <td class="text-nowrap">{{ msg.received_at|fecha }}</td>
        <td class="text-break">{{ msg.direction == 'inbound' ? msg.from_address : (msg.to_addresses|json_decode|default([])|join(', ')) }}</td>
        <td class="text-break">{{ msg.subject }}{% if msg.error %}<div class="text-danger">{{ msg.error }}</div>{% endif %}</td>
        <td>{{ st[msg.processing_status] ?? msg.processing_status }}</td>
        <td>{% if msg.ticket_id %}<a href="/incidencias/{{ msg.ticket_id }}">Ver</a>{% elseif msg.processing_status == 'review' %}<a href="/revision">Revisar</a>{% endif %}</td>
    </tr>
    {% else %}<tr><td colspan="6" class="text-muted p-3">Sin mensajes.</td></tr>{% endfor %}
    </tbody>
</table></div></div>
<div class="card"><div class="card-header">Eventos de lectura</div><div class="table-responsive"><table class="table table-sm align-middle mb-0 small">
    <tbody>
    {% for r in rows %}
    <tr class="{{ r.level == 'error' ? 'table-danger' : (r.level == 'warning' ? 'table-warning' : '') }}">
        <td class="text-nowrap">{{ r.created_at|fecha }}</td><td>{{ r.level == 'error' ? 'Error' : (r.level == 'warning' ? 'Aviso' : 'Info') }}</td>
        <td class="text-break">{{ r.message }}{% if r.subject %}<div class="text-muted">{{ r.from_address }} · {{ r.subject }}</div>{% endif %}</td>
        <td>{% if r.ticket_id %}<a href="/incidencias/{{ r.ticket_id }}">Incidencia</a>{% endif %}</td>
    </tr>
    {% else %}<tr><td class="text-muted p-3">Sin eventos todavía.</td></tr>{% endfor %}
    </tbody>
</table></div></div>
{{ m.pagination(total, page, per) }}
{% endblock %}
