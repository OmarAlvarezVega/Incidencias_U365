{% extends 'layouts/app.twig' %}
{% block title %}Informes{% endblock %}
{% block content %}
<div class="page-header"><div><h1>Informes</h1><div class="subtitle">{{ can('reports.view.all') ? 'Datos de toda la empresa' : 'Datos de tus equipos' }}</div></div></div>
{% set icons = {incidencias: 'list-ul', clientes: 'buildings', empleados: 'people', tiempos: 'clock-history', sla: 'stopwatch', categorias: 'tags', canales: 'signpost-split'} %}
<div class="row g-3">
{% for code, name in reports %}
    <div class="col-sm-6 col-lg-4"><a class="card h-100 text-decoration-none" href="/informes/{{ code }}"><div class="card-body d-flex gap-3 align-items-center">
        <i class="bi bi-{{ icons[code] ?? 'file-text' }} fs-3 text-primary"></i><div><div class="fw-semibold text-body">{{ name }}</div><div class="small text-muted">Filtra por fechas, cliente, equipo o empleado{{ can('tickets.export') ? ' y exporta a Excel o CSV' }}.</div></div>
    </div></a></div>
{% endfor %}
</div>
{% endblock %}
