{
    "name": "univers365/incidencias",
    "description": "UNIVERS365 Incident Management: gestión de incidencias para hosting compartido",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-sodium": "*",
        "ext-fileinfo": "*",
        "ext-json": "*",
        "twig/twig": "^3.14",
        "phpmailer/phpmailer": "^6.9",
        "zbateson/mail-mime-parser": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.4"
    },
    "suggest": {
        "ext-intl": "Formato de fechas y números es_ES",
        "ext-zip": "Exportación XLSX y copias de adjuntos",
        "ext-curl": "Llamadas HTTP a Meta y Microsoft (hay alternativa con streams)"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
